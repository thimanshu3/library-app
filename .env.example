# Existing Postgres connection settings
DATABASE_URL=
DIRECT_URL=

# Generate these with pnpm auth:setup. Never use NEXT_PUBLIC_ for credentials.
LIBRARY_OWNER_NAME=owner
LIBRARY_OWNER_PASSWORD_HASH=
LIBRARY_SESSION_SECRET=

# Optional canonical HTTPS origin, particularly behind a reverse proxy.
LIBRARY_APP_ORIGIN=

# Local development defaults to private files in .data/library-files.
# Production requires explicit storage configuration. Use a private S3-compatible
# bucket, or choose local with an absolute path on a persistent mounted volume.
LIBRARY_STORAGE_DRIVER=
LIBRARY_STORAGE_DIRECTORY=
LIBRARY_STORAGE_BUCKET=
LIBRARY_STORAGE_REGION=
LIBRARY_STORAGE_ENDPOINT=
# For S3: use the deployment IAM role or the usual AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, and (when applicable) AWS_SESSION_TOKEN environment vars.

# Optional server-side Google Books quota key (restrict it in Google Cloud).
GOOGLE_BOOKS_API_KEY=
