generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Work {
  id                      String  @id
  title                   String
  author                  String
  genre                   String
  hours                   String
  recommendedBy           String
  volume                  String?
  photoUrl                String
  summary                 String
  description             String?
  launchYear              String?
  originalLanguage        String?
  countryOfOrigin         String?
  authorDescription       String?
  coverFile               String?
  isbn                    String?
  tags                    Json?
  collections             Json?
  series                  String?
  apiData                 Json?
  readingSpans            Json?
  additionalAuthors       String?
  authorLF                String?
  goodreadsId             String?
  originalPublicationYear String?
  ownedCopies             Int?
  publisher               String?
  yearPublished           String?
  binding                 String?
  isbn13                  String?
  pageCount               Int?
  libraryOrder            BigInt @default(0)
  launchYearNumber        Int?
  revision                Int @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt
  editions                Edition[]
  copies                  Copy[]

  @@index([libraryOrder, id])
  @@index([launchYearNumber, id])
  @@index([author, id])
  @@index([title, id])
  @@index([genre, volume])
}

model Copy {
  createFingerprint        String?
  id                       String  @id
  workId                   String
  format                   String
  condition                String
  shelfLocation            String
  purchased                Boolean
  purchasePrice            Decimal? @db.Decimal(12, 2)
  investedAmount           Decimal? @db.Decimal(12, 2)
  status                   String
  pdfPath                  String?
  currentPage              Int?
  totalPages               Int?
  lastReadTimestamp        String?
  readingSessions          Json?
  rating                   Int?
  quotes                   Json?
  amazonLink               String?
  loans                    Json?
  bookshelves              String?
  bookshelvesWithPositions String?
  dateAdded                String?
  dateRead                 String?
  exclusiveShelf           String?
  myReview                 String?
  privateNotes             String?
  readCount                Int?
  spoiler                  String?
  editionId                String?
  ownership                String @default("Purchased")
  currency                 String @default("INR")
  readingSpans             Json?
  readingStartedAt         DateTime? @db.Date
  readingCompletedAt       DateTime? @db.Date
  epubLocation             String?
  mediaType                String?
  attachmentKey            String?
  offerPrice               Decimal? @db.Decimal(12, 2)
  offerCurrency            String?
  offerCheckedAt           DateTime?
  offerSource              String?
  revision                 Int @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt
  edition                  Edition? @relation(fields: [editionId], references: [id], onDelete: Restrict)
  attachment               Attachment? @relation(fields: [attachmentKey], references: [key], onDelete: Restrict)
  sessions                 ReadingSessionRecord[]
  loanRecords              Loan[]
  work                     Work    @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId, id])
  @@index([editionId])
  @@index([attachmentKey])
  @@index([status, id])
  @@index([ownership, status])
  @@index([shelfLocation, id])
  @@index([investedAmount, id])
  @@index([readingCompletedAt])
}

model Edition {
  id              String @id
  workId          String
  isbn            String?
  publisher       String?
  publicationYear Int?
  format          String
  pageCount       Int?
  work            Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  copies          Copy[]
  @@index([workId, isbn])
}

model ReadingSessionRecord {
  id              String @id
  copyId          String
  date            DateTime @db.Date
  durationMinutes Decimal @db.Decimal(10, 4)
  startPage       Int
  endPage         Int
  observedAt      DateTime
  copy            Copy @relation(fields: [copyId], references: [id], onDelete: Cascade)
  @@index([copyId, date])
  @@index([date])
}

model Loan {
  id                 String @id
  copyId             String
  borrowerName       String
  dateLent           DateTime @db.Date
  expectedReturnDate DateTime? @db.Date
  dateReturned       DateTime? @db.Date
  notes              String @default("")
  copy               Copy @relation(fields: [copyId], references: [id], onDelete: Cascade)
  @@index([copyId, dateReturned])
  @@index([dateReturned, expectedReturnDate])
}

model Attachment {
  key         String @id
  createdAt   DateTime @default(now())
  status      String @default("active")
  deleteAfter DateTime?
  copies      Copy[]
  @@index([status, deleteAfter])
}

model LibrarySettings {
  id         String @id @default("owner")
  annualGoal Int @default(50)
  updatedAt  DateTime @default(now()) @updatedAt
}
